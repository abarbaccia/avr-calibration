#!/usr/bin/env bash
# audio-mode — switch the Pi audio stack between listening / cal / karaoke,
# and own ALL camilladsp_capture PipeWire wiring (`audio-mode wire`).
#
# Modes:
#   listening : CamillaDSP runs, pikaraoke container stopped.
#               Normal home-theater operation. AVR sub pre-out → Scarlett input 3
#               (port capture_AUX2) → camilladsp_capture:input_3 → subs.
#   cal       : CamillaDSP runs, pikaraoke container stopped.
#               Calibration routing: avr_cal_sweep null sink → camilladsp_capture:input_3.
#               Also pins the Pi→AVR HDMI card to the 8-ch surround71 profile so
#               discrete per-channel mains sweeps aren't downmixed to stereo.
#   karaoke   : CamillaDSP stopped, pikaraoke container running. pikaraoke owns
#               the Scarlett directly — no dmix, no buzz.
#
# ── Wiring ownership (single source of truth) ──────────────────────────────
# CamillaDSP's capture node has node.autoconnect=false (autoconnect_to: null in
# scarlett.yml). WirePlumber NEVER links camilladsp_capture — history showed WP
# fallback behaviour linking the UMIK into the DSP capture (mic→subs→room→mic
# feedback loop, 2026-06-12). All capture links are created here, explicitly:
#
#   cal:       avr_cal_sweep:monitor_FL      → camilladsp_capture:input_3
#   listening: Scarlett:capture_AUX2         → camilladsp_capture:input_3
#   always:    avr_cal_sweep:monitor_FL      → loopback_ref:playback_FL  (ref X, ch0)
#   always:    UMIK:capture_FL               → loopback_ref:playback_FR  (mic Y, ch1)
#   always:    remove any UMIK→camilladsp_capture links (feedback-loop guard)
#
# `audio-mode wire` is invoked from three places so the graph re-converges
# after every disruption:
#   1. avr-cal-sweep-link.service (user)  — at session/boot start
#   2. camilladsp.service ExecStartPost   — after every CamillaDSP restart
#   3. camilladsp-watchdog.sh             — every poll (idempotent self-heal)
#
# State file: /var/lib/audio-mode (single token: listening|cal|karaoke).
# /var/lib survives reboots; /run (tmpfs) was wiped on every Pi restart, causing
# audio-mode get to return "unknown" and requiring manual re-set after each reboot.
# Read by camilladsp-watchdog.sh so it does NOT self-heal CamillaDSP during karaoke.

set -u

STATE_FILE="${STATE_FILE:-/var/lib/audio-mode}"
CAMILLA_SVC="${CAMILLA_SVC:-camilladsp.service}"
PIKARAOKE_CONTAINER="${PIKARAOKE_CONTAINER:-pikaraoke}"
CAL_API_URL="${CAL_API_URL:-http://127.0.0.1:8000/api/cal-mode}"

# PipeWire session env — works for both the pi user and root (watchdog).
PW_ENV="XDG_RUNTIME_DIR=/run/user/1000 PIPEWIRE_RUNTIME_DIR=/run/user/1000"

# Node names. The Scarlett MUST be on the ACP multichannel profile
# (pinned in 50-scarlett.lua) — the pro-audio profile renames these nodes
# to pro-output-0/pro-input-0 and breaks every consumer.
SCARLETT_CAPTURE="alsa_input.usb-Focusrite_Scarlett_18i20_USB_P9W3FNX378D03D-00.multichannel-input"
SCARLETT_PLAYBACK="alsa_output.usb-Focusrite_Scarlett_18i20_USB_P9W3FNX378D03D-00.multichannel-output"
UMIK_NODE="alsa_input.usb-miniDSP_Umik-1_Gain__18dB_00002-00.analog-stereo"
CAM_CAPTURE="camilladsp_capture"
SWEEP_SINK="avr_cal_sweep"
LOOPBACK_REF="loopback_ref"

# HDMI output card (Pi → AVR). Cal-mode mains sweeps inject discrete 6/8-ch
# LPCM into the AVR over this card, so the 8-ch hdmi-surround71 sink MUST exist.
# That sink is created only when the card's ACP is on the surround71 profile,
# which WirePlumber enumerates from the AVR's EDID at card-creation time — if the
# AVR was off / on another input / advertising stereo when WP enumerated, only the
# stereo sink exists and a 6-ch sweep is silently downmixed to stereo, so the
# discrete channel never reaches its speaker ("sweep not detected"). cal mode pins
# this profile explicitly instead of depending on enumeration timing luck.
HDMI_CARD="${HDMI_CARD:-alsa_card.platform-107c701400.hdmi}"
HDMI_SURROUND_PROFILE="${HDMI_SURROUND_PROFILE:-output:hdmi-surround71}"

# How long `wire` waits for camilladsp_capture ports to appear (seconds × 0.5).
# The watchdog sets WIRE_RETRIES=1 — in its healthy path ports always exist.
WIRE_RETRIES="${WIRE_RETRIES:-12}"

usage() {
    cat <<EOF
usage: audio-mode <command>

commands:
  get                       Print current mode (listening|cal|karaoke|unknown).
  set <listening|cal|karaoke>
                            Transition to the named mode.
  wire [mode]               (Re)create the camilladsp_capture PipeWire links for
                            the given mode (default: current mode). Idempotent.
                            Also removes stray UMIK→capture links and ensures the
                            loopback_ref deconvolution tap.

state file: $STATE_FILE  (persists across reboots)
EOF
}

log() { echo "[audio-mode] $*" >&2; }

# Bass-shaker output is on Scarlett 18i20 Line 08 (per output_slots index 7,
# label "Bass Shakers (via NX3000) — Line 08"). Mute it whenever the shaker
# shouldn't be felt: during calibration (acoustic-only target) and during
# karaoke. Unmute for listening.
SHAKER_MUTE_CTL="${SHAKER_MUTE_CTL:-Line 08 Mute}"
SHAKER_CARD="${SHAKER_CARD:-USB}"

set_shaker_mute() {
    local state="$1"   # on=muted, off=unmuted
    amixer -c "$SHAKER_CARD" sset "$SHAKER_MUTE_CTL" "$state" >/dev/null 2>&1 \
        && log "shaker mute → $state" \
        || log "WARNING: failed to set shaker mute=$state (Scarlett missing?)"
}

# Chromium kiosk lifecycle. The kiosk is the audio-playback head for karaoke
# (Chromium writes to ALSA "default" → karaoke_out plug → Scarlett PCM 1/2 →
# Mix A/B → Line 1/2 → Denon). Two operations:
#
#   kill_kiosk     stop chromium so it releases Scarlett (used before starting
#                  CamillaDSP — otherwise CamillaDSP can't grab hw:USB,0,0)
#   relaunch_kiosk kill + re-launch (returns kiosk to splash with fresh ALSA state)
#
# In listening + cal modes the kiosk runs but cannot grab Scarlett (CamillaDSP
# holds it exclusively). Chromium audio attempts fail silently — desired.
KIOSK_RELAUNCH="${KIOSK_RELAUNCH:-/home/pi/.config/labwc/relaunch-kiosk.sh}"
kill_kiosk() {
    pkill -f 'chromium.*chromium-kiosk' 2>/dev/null
    # wait briefly for the audio device to be released
    for _ in 1 2 3 4 5; do
        sudo fuser /dev/snd/pcmC3D0p 2>/dev/null | grep -q . || break
        sleep 0.3
    done
}
relaunch_kiosk() {
    if [ -x "$KIOSK_RELAUNCH" ]; then
        sudo -u pi -H \
            env XDG_RUNTIME_DIR=/run/user/1000 WAYLAND_DISPLAY=wayland-0 \
            "$KIOSK_RELAUNCH" >/dev/null 2>&1 &
        log "chromium kiosk relaunch scheduled"
    fi
}

current_mode() {
    if [ -r "$STATE_FILE" ]; then
        cat "$STATE_FILE"
    else
        echo "unknown"
    fi
}

write_state() {
    local mode="$1"
    echo "$mode" > "$STATE_FILE"
}

ensure_camilladsp_up() {
    if ! systemctl is-active --quiet "$CAMILLA_SVC"; then
        log "starting $CAMILLA_SVC"
        systemctl start "$CAMILLA_SVC"
        # Wait until websocket reports Running (or give up after ~15s).
        for _ in $(seq 1 15); do
            if probe_camilla_running; then return 0; fi
            sleep 1
        done
        log "WARNING: $CAMILLA_SVC did not reach Running within 15s"
        return 1
    fi
    return 0
}

ensure_camilladsp_down() {
    if systemctl is-active --quiet "$CAMILLA_SVC"; then
        log "stopping $CAMILLA_SVC"
        systemctl stop "$CAMILLA_SVC"
    fi
}

ensure_pikaraoke_up() {
    if ! docker ps --format '{{.Names}}' | grep -qx "$PIKARAOKE_CONTAINER"; then
        log "starting $PIKARAOKE_CONTAINER container"
        docker start "$PIKARAOKE_CONTAINER" >/dev/null
    fi
}

ensure_pikaraoke_down() {
    if docker ps --format '{{.Names}}' | grep -qx "$PIKARAOKE_CONTAINER"; then
        log "stopping $PIKARAOKE_CONTAINER container"
        docker stop "$PIKARAOKE_CONTAINER" >/dev/null
    fi
}

probe_camilla_running() {
    python3 - <<'PY' 2>/dev/null
import asyncio, json, sys
try:
    import websockets
except ImportError:
    sys.exit(2)
async def go():
    try:
        async with websockets.connect("ws://127.0.0.1:1234", open_timeout=2, close_timeout=1) as ws:
            await ws.send('"GetState"')
            r = json.loads(await asyncio.wait_for(ws.recv(), timeout=2))
            sys.exit(0 if r.get("GetState", {}).get("value") == "Running" else 1)
    except Exception:
        sys.exit(1)
asyncio.run(go())
PY
}

# ── PipeWire wiring ─────────────────────────────────────────────────────────

# pw-link FROM TO. "File exists" = already linked = success (idempotent).
# Every pw-link is wrapped in `timeout` so a single call can NEVER block:
# on a mid-convergence/wedged graph pw-link can hang indefinitely, and when
# this ran synchronously as camilladsp.service ExecStartPost that hang tripped
# the systemd start-post timeout → daemon killed → restart flap → polluted
# graph (root cause of the 2026-06-13 boot wedge). Bounded calls + the
# backgrounded ExecStartPost (see camilladsp.service) make wiring self-healing.
PW_LINK_TIMEOUT="${PW_LINK_TIMEOUT:-4}"
link_one() {
    local out
    out=$(timeout "$PW_LINK_TIMEOUT" env $PW_ENV pw-link "$1" "$2" 2>&1) && return 0
    echo "$out" | grep -q 'File exists' && return 0
    return 1
}

unlink_one() { timeout "$PW_LINK_TIMEOUT" env $PW_ENV pw-link -d "$1" "$2" 2>/dev/null || true; }

port_exists() {
    timeout "$PW_LINK_TIMEOUT" env $PW_ENV pw-link -o -i 2>/dev/null | grep -qF "$1"
}

# Run a client in the pi user's PW/Pulse session regardless of our own uid.
# pactl/wpctl/systemctl --user need the pi user's bus + pulse socket; unlike
# pw-link (PipeWire-native, reachable by root via PIPEWIRE_RUNTIME_DIR), `env
# XDG_RUNTIME_DIR=…` alone is NOT enough for pactl as root — it must drop to pi.
as_pi() {
    if [ "$(id -u)" = "0" ]; then
        sudo -u pi env XDG_RUNTIME_DIR=/run/user/1000 "$@"
    else
        env XDG_RUNTIME_DIR=/run/user/1000 "$@"
    fi
}

restart_wireplumber() {
    # Force ACP to re-read the HDMI EDID and re-enumerate profiles.
    as_pi systemctl --user restart wireplumber 2>/dev/null
}

hdmi_active_profile() {
    as_pi timeout "$PW_LINK_TIMEOUT" pactl list cards 2>/dev/null \
        | sed -n "/Name: ${HDMI_CARD}\$/,/^Card #/p" \
        | awk '/Active Profile:/{print $3; exit}'
}

ensure_hdmi_surround() {
    # Deterministically put the HDMI card on the surround71 profile so the 8-ch
    # sink exists for cal-mode mains sweeps. Selecting an available profile creates
    # its sink node, so this is the establish step (not just a preference hint like
    # the WP apply-properties rule, which can only pick from already-enumerated
    # profiles and cannot create one).
    #   allow_restart=0 (wire / watchdog path): idempotent re-pin only, NEVER a WP
    #                   restart — frequent WP restarts flap every link (boot-wedge,
    #                   2026-06-13). Silent when already correct (no log spam).
    #   allow_restart=1 (deliberate `set cal`): if the profile isn't available
    #                   (AVR was off/stereo at WP enum), restart WP to re-read the
    #                   EDID, then set it. Caller re-wires after (links drop on
    #                   restart). Requires the AVR powered on + on the HDMI input.
    local allow_restart="${1:-0}"
    [ "$(hdmi_active_profile)" = "$HDMI_SURROUND_PROFILE" ] && return 0
    if as_pi timeout "$PW_LINK_TIMEOUT" \
        pactl set-card-profile "$HDMI_CARD" "$HDMI_SURROUND_PROFILE" 2>/dev/null; then
        log "HDMI card → $HDMI_SURROUND_PROFILE (8-ch sink for mains sweeps)"
        return 0
    fi
    log "WARNING: $HDMI_SURROUND_PROFILE not available on $HDMI_CARD (AVR off / stereo-only at WP enum?)"
    if [ "$allow_restart" = "1" ]; then
        log "restarting WirePlumber to re-enumerate HDMI profiles (AVR must be ON + on the Pi's HDMI input)"
        restart_wireplumber
        sleep 3
        if as_pi timeout "$PW_LINK_TIMEOUT" \
            pactl set-card-profile "$HDMI_CARD" "$HDMI_SURROUND_PROFILE" 2>/dev/null; then
            log "HDMI card → $HDMI_SURROUND_PROFILE (after WP re-enumerate)"
            return 0
        fi
        log "ERROR: $HDMI_SURROUND_PROFILE still unavailable after WP restart — is the AVR powered on and on the Pi's HDMI input?"
    fi
    return 1
}

remove_umik_links() {
    # Feedback-loop guard: the UMIK is captured directly by the bare-metal
    # measurement service (PortAudio). A UMIK→camilladsp_capture link creates
    # a mic→DSP→subs→room→mic acoustic loop (fabricated per-sub deficits,
    # ±21 dB polarity-flip swings — verified 2026-06-12).
    for port in input_1 input_2 input_3 input_4; do
        unlink_one "${UMIK_NODE}:capture_FL" "${CAM_CAPTURE}:${port}"
        unlink_one "${UMIK_NODE}:capture_FR" "${CAM_CAPTURE}:${port}"
    done
}

cmd_wire() {
    local mode="${1:-$(current_mode)}"

    case "$mode" in
        karaoke)
            log "wire: karaoke mode — CamillaDSP down, nothing to wire"
            return 0
            ;;
        listening|cal) ;;
        *)
            log "wire: unknown mode '$mode' — set a mode first (audio-mode set <mode>)"
            return 2
            ;;
    esac

    remove_umik_links

    # R11 single sample-locked capture (docs/pipewire-architecture.md §6b):
    # loopback_ref is a 2-ch sink — ch0 (FL) = pre-DSP stimulus reference,
    # ch1 (FR) = UMIK mic. Recording this ONE node gives ref+mic sample-locked
    # (no inter-stream start offset to corrupt the deconvolution). The UMIK rides
    # PW's resampler onto the graph clock into FR (R6 preserved). loopback_ref is a
    # null sink whose monitor is only RECORDED (never routed to the subs), so the
    # mic→sink link is not a feedback path.
    link_one "${SWEEP_SINK}:monitor_FL" "${LOOPBACK_REF}:playback_FL" \
        || log "WARNING: loopback_ref FL (ref) link failed (${SWEEP_SINK} or ${LOOPBACK_REF} missing?)"
    link_one "${UMIK_NODE}:capture_FL" "${LOOPBACK_REF}:playback_FR" \
        || log "WARNING: loopback_ref FR (mic) link failed (UMIK or ${LOOPBACK_REF} missing?)"

    # Playback: camilladsp_playback:output_N+1 → Scarlett playback_AUXN (20 ch).
    # WP 0.4.13's link policy wedges permanently when any client dies mid-
    # activation ("N pending linkables... should never happen"), after which it
    # creates no links at all. We stopped depending on it: wire owns these too.
    local n ok=0
    for n in $(seq 0 19); do
        link_one "camilladsp_playback:output_$((n+1))" \
                 "${SCARLETT_PLAYBACK}:playback_AUX${n}" && ok=$((ok+1))
    done
    [ "$ok" -lt 20 ] && log "WARNING: only ${ok}/20 playback→Scarlett links up"

    # camilladsp_capture ports appear a moment after CamillaDSP starts — retry.
    local i
    for i in $(seq 1 "$WIRE_RETRIES"); do
        port_exists "${CAM_CAPTURE}:input_3" && break
        if [ "$i" -eq "$WIRE_RETRIES" ]; then
            log "WARNING: ${CAM_CAPTURE}:input_3 not found after ${WIRE_RETRIES} attempts — is CamillaDSP running?"
            return 1
        fi
        sleep 0.5
    done

    case "$mode" in
        cal)
            unlink_one "${SCARLETT_CAPTURE}:capture_AUX2" "${CAM_CAPTURE}:input_3"
            if link_one "${SWEEP_SINK}:monitor_FL" "${CAM_CAPTURE}:input_3"; then
                log "wired (cal): ${CAM_CAPTURE}:input_3 ← ${SWEEP_SINK}:monitor_FL"
            else
                log "ERROR: could not link ${SWEEP_SINK} → ${CAM_CAPTURE}:input_3"
                return 1
            fi
            # Keep the HDMI card on the 8-ch surround profile so mains sweeps
            # aren't downmixed. Idempotent re-pin only — no WP restart on this
            # frequently-called path (the watchdog runs `wire` every poll).
            ensure_hdmi_surround 0 || true
            ;;
        listening)
            unlink_one "${SWEEP_SINK}:monitor_FL" "${CAM_CAPTURE}:input_3"
            if link_one "${SCARLETT_CAPTURE}:capture_AUX2" "${CAM_CAPTURE}:input_3"; then
                log "wired (listening): ${CAM_CAPTURE}:input_3 ← Scarlett:capture_AUX2 (Denon LFE)"
            else
                log "ERROR: could not link Scarlett:capture_AUX2 → ${CAM_CAPTURE}:input_3"
                return 1
            fi
            ;;
    esac
    return 0
}

# Note: CamillaDSP-internal cal_mode state is still owned by the avr-calibration
# recipes via MCP (single coordination point). `wire` owns only the PW-graph
# question: which source feeds camilladsp_capture:input_3.

cmd_set() {
    local target="$1"
    case "$target" in
        listening)
            kill_kiosk                            # free Scarlett before camilladsp grabs it
            ensure_pikaraoke_down
            ensure_camilladsp_up || true
            write_state listening
            cmd_wire listening || true
            set_shaker_mute off                   # shaker unmuted in listening
            relaunch_kiosk                        # kiosk back up; can't grab Scarlett (camilla has it) — fine
            log "→ listening  (Scarlett:AUX2 → input_3; subs + shakers unmuted)"
            ;;
        cal)
            kill_kiosk                            # free Scarlett before camilladsp grabs it
            ensure_pikaraoke_down
            ensure_camilladsp_up || true
            write_state cal
            # Establish the 8-ch HDMI surround sink BEFORE wiring: if the profile
            # isn't available (AVR was off at WP enum) this restarts WirePlumber to
            # re-read the EDID, which drops all PW links — cmd_wire below then
            # re-creates them. Needs the AVR powered on + on the Pi's HDMI input.
            ensure_hdmi_surround 1 || true
            cmd_wire cal || true
            set_shaker_mute on                    # shaker muted during calibration
            relaunch_kiosk
            log "→ cal  (avr_cal_sweep → input_3; shaker muted)"
            ;;
        karaoke)
            ensure_camilladsp_down                # release Scarlett for Chromium
            ensure_pikaraoke_up
            set_shaker_mute on                    # shaker muted during karaoke
            write_state karaoke
            relaunch_kiosk                        # Chromium re-opens PCM 1/2 via karaoke_out
            log "→ karaoke  (shaker muted; kiosk audio → Scarlett PCM 1/2 → Line 1/2)"
            ;;
        *)
            echo "unknown mode: $target" >&2
            usage
            exit 2
            ;;
    esac
}

case "${1:-}" in
    get)            current_mode ;;
    set)            shift; cmd_set "${1:-}" ;;
    wire)           shift; cmd_wire "${1:-}" ;;
    ""|-h|--help)   usage ;;
    *)              usage; exit 2 ;;
esac
