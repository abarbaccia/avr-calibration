[Unit]
Description=AVR Calibration — web server (Docker)
After=network.target docker.service
Requires=docker.service

[Service]
Type=simple
User=pi
# Wait up to 30s for hidraw0 (miniDSP) to appear before starting
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -e /dev/hidraw0 ] && exit 0; sleep 1; done; echo "WARNING: /dev/hidraw0 not found after 30s, starting without miniDSP"; exit 0'
ExecStartPre=-/usr/bin/docker rm -f avr-calibration
ExecStart=/usr/bin/docker run --rm \
    --name avr-calibration \
    -p 8000:8000 \
    --device=/dev/hidraw0 \
    -v /home/pi/.avr-calibration:/data/.avr-calibration \
    ghcr.io/abarbaccia/avr-calibration:latest
ExecStop=/usr/bin/docker stop avr-calibration
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
