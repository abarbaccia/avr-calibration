[Unit]
Description=CamillaDSP audio processor
After=sound.target network.target

[Service]
Type=simple
User=pi
Group=audio
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=PIPEWIRE_RUNTIME_DIR=/run/user/1000
# Force pipewire-alsa to use 256-frame periods matching CamillaDSP's chunksize
Environment=PIPEWIRE_ALSA=api.alsa.period-size=256,api.alsa.period-num=4,audio.channels=20,audio.position=AUX0:AUX1:AUX2:AUX3:AUX4:AUX5:AUX6:AUX7:AUX8:AUX9:AUX10:AUX11:AUX12:AUX13:AUX14:AUX15:AUX16:AUX17:AUX18:AUX19
ExecStartPre=/bin/bash -c 'for i in $(seq 30); do [ -S /run/user/1000/pipewire-0 ] && exit 0; sleep 0.5; done; echo "CamillaDSP: PipeWire socket not ready"; exit 1'
ExecStart=/usr/local/bin/camilladsp --port 1234 --address 127.0.0.1 --statefile /home/pi/camilladsp/statefile.yml --wait --logfile /home/pi/camilladsp/logs/camilladsp.log -l info
# Re-wire camilladsp_capture for the current audio mode (cal: avr_cal_sweep,
# listening: Scarlett AUX2). camilladsp_capture has node.autoconnect=false so
# WirePlumber never links it — audio-mode wire is the single wiring owner.
# Links die whenever this service restarts (the capture node's ports are
# recreated), so this must run on every start, not just at boot.
ExecStartPost=/usr/local/sbin/audio-mode wire
Restart=on-failure
RestartSec=5
LimitRTPRIO=95
LimitMEMLOCK=infinity

[Install]
WantedBy=multi-user.target
